{
  "server": {
    "host": "127.0.0.1",
    "port": 11434,
    "max_connections": 64
  },

  "database": {
    "path": "funcroute-test.db"
  },
  "providers": {
    "deepseek": {
      "type": "openai",
      "base_url": "http://127.0.0.1:9101",
      "api_key": "test-deepseek-key",
      "model": "deepseek-v4-flash",
      "reasoning": "high",
      "timeout_secs": 10
    },
    "deepseek-vl": {
      "type": "openai",
      "base_url": "http://127.0.0.1:9102",
      "api_key": "test-openrouter-key",
      "model": "deepseek/deepseek-v4.1-flash",
      "reasoning": "low",
      "timeout_secs": 10
    },
    "qwen-omni": {
      "type": "openai",
      "base_url": "http://127.0.0.1:9102",
      "api_key": "test-openrouter-key",
      "model": "qwen/qwen3.8-omni-flash",
      "reasoning": "low",
      "timeout_secs": 10
    }
  },
  "routing": {
    "default_provider": "deepseek",
    "image_provider": "deepseek-vl",
    "file_provider": "deepseek-vl",
    "audio_provider": "qwen-omni",
    "media_provider": "deepseek-vl",
    "image_content_type": "image_url",
    "audio_content_type": "input_audio",
    "file_content_type": "file",
    "endpoint": "/v1/chat/completions",
    "ollama_model": "bhag",
    "max_request_bytes": 4096,
    "max_messages": 20,
    "advertised_context_length": 200000
  }
}
